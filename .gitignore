*.tmp_proj
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Backup & report files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak
*.mdmp

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCopReport.xml

# Files generated by Click-Once
publish/

# Publish profiles
*.pubxml
*.pubxml.user
*.azurePubxml
*.publishproj
*.publishsettings

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# checkin your Azure Web App publish settings, but sensitive information contained
# in these scripts will be unencrypted
PublishScripts/

# NuGet Configuration
nuget.config

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# Git
.git/
.gitattributes

# GitHub
.github/

# node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Mac
.DS_Store

# Temporary files created by Visual Studio
*.tmp
*.temp

# Enable "show all files" in Visual Studio
~$*
